# Which sources the agent loop fans out to (JSON list syntax)
ENABLED_SOURCES=["mock"]

# eBay Browse API (https://developer.ebay.com/) — source name: "ebay"
EBAY_API_KEY=

# Reddit OAuth app (https://www.reddit.com/prefs/apps) — source name: "reddit"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Craigslist city subdomain — source name: "craigslist"
# e.g. "hampton", "washingtondc", "newyork"
CRAIGSLIST_CITY=hampton
